# Anisette Server Configuration

# Server Binding
ANISETTE_HOSTNAME=0.0.0.0
ANISETTE_PORT=8000

# Logging
ANISETTE_LOG_LEVEL=INFO

# TLS/HTTPS Configuration
ANISETTE_TLS_ENABLED=false
# ANISETTE_TLS_CERT_PATH=/path/to/cert.pem
# ANISETTE_TLS_KEY_PATH=/path/to/key.pem

# Storage Paths (Optional, defaults to XDG directories)
# ANISETTE_STORAGE_PATH=/path/to/data
# ANISETTE_CONFIG_PATH=/path/to/config
